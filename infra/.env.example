# Entorno LOCAL de desarrollo. Copiar a infra/.env (no se versiona).
# En Azure estos valores salen de Key Vault; nunca se reutilizan.

POSTGRES_PORT=5433
PGBOUNCER_PORT=6432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dev_postgres_superuser
POSTGRES_DB=dynadrill

# Un usuario de BD por contenedor (documento de BD, cap. 4.2)
DYN_MIGRATOR_PASSWORD=dev_dyn_migrator
DYN_LECTURA_PASSWORD=dev_dyn_lectura
APP_PLATAFORMA_PASSWORD=dev_app_plataforma
APP_COMERCIAL_PASSWORD=dev_app_comercial
APP_OPERACIONES_PASSWORD=dev_app_operaciones
APP_QHSE_PASSWORD=dev_app_qhse
APP_WORKER_PASSWORD=dev_app_worker
PGBOUNCER_AUTH_PASSWORD=dev_pgbouncer_auth

RABBITMQ_USER=dynadrill
RABBITMQ_PASSWORD=dev_rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

AZURITE_BLOB_PORT=10000
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
