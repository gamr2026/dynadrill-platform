{
  "name": "@dyn/source",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Plataforma Dynadrill: backend de producción (monorepo Nx, NestJS, Prisma, PostgreSQL).",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v",
    "dev:setup": "node scripts/dev-setup.mjs",
    "dev:token": "node scripts/dev-token.mjs",
    "test:integration": "cross-env RUN_INTEGRATION=1 nx run-many -t test --skip-nx-cache",
    "db:migrate:identidad": "cd libs/plataforma/identidad && prisma migrate deploy",
    "db:generate": "nx run-many -t prisma-generate",
    "db:seed:identidad": "tsx --tsconfig tsconfig.base.json libs/plataforma/identidad/prisma/seed.ts",
    "db:migrate-demo:identidad": "tsx --tsconfig tsconfig.base.json libs/plataforma/identidad/prisma/migrate-from-demo.ts",
    "db:migrate-demo:comercial": "tsx --tsconfig tsconfig.base.json libs/comercial/pedidos/prisma/migrate-from-demo.ts",
    "db:migrate:comercial": "cd libs/comercial/pedidos && prisma migrate deploy",
    "db:migrate:pumping": "cd libs/operaciones/pumping && prisma migrate deploy",
    "db:migrate:qhse": "cd libs/qhse/seguridad && prisma migrate deploy",
    "db:seed:qhse": "tsx --tsconfig tsconfig.base.json libs/qhse/seguridad/prisma/seed.ts",
    "db:cargar:iperc": "tsx --tsconfig tsconfig.base.json libs/qhse/seguridad/prisma/cargar-iperc.ts",
    "db:migrate:flota": "cd libs/operaciones/flota && prisma migrate deploy",
    "db:seed:flota": "tsx --tsconfig tsconfig.base.json libs/operaciones/flota/prisma/seed.ts",
    "db:migrate:mantenimiento": "cd libs/operaciones/mantenimiento && prisma migrate deploy",
    "db:seed:mantenimiento": "tsx --tsconfig tsconfig.base.json libs/operaciones/mantenimiento/prisma/seed.ts",
    "db:migrate:inventario": "cd libs/operaciones/inventario && prisma migrate deploy",
    "db:seed:inventario": "tsx --tsconfig tsconfig.base.json libs/operaciones/inventario/prisma/seed.ts",
    "db:cargar:inventario": "tsx --tsconfig tsconfig.base.json libs/operaciones/inventario/prisma/cargar-datos-reales.ts",
    "db:cargar:epp": "tsx --tsconfig tsconfig.base.json libs/operaciones/inventario/prisma/cargar-epp.ts",
    "db:cargar:bienes": "tsx --tsconfig tsconfig.base.json libs/operaciones/inventario/prisma/cargar-bienes-as2.ts",
    "db:cargar:stock": "tsx --tsconfig tsconfig.base.json libs/operaciones/inventario/prisma/cargar-stock-as2.ts",
    "db:normalizar:codigos": "tsx --tsconfig tsconfig.base.json libs/operaciones/inventario/prisma/normalizar-codigos.ts",
    "db:migrate:avisos": "cd libs/plataforma/avisos && prisma migrate deploy",
    "db:seed:avisos": "tsx --tsconfig tsconfig.base.json libs/plataforma/avisos/prisma/seed.ts",
    "db:migrate:encuestas": "cd libs/plataforma/encuestas && prisma migrate deploy",
    "db:seed:encuestas": "tsx --tsconfig tsconfig.base.json libs/plataforma/encuestas/prisma/seed.ts",
    "db:seed:pumping": "tsx --tsconfig tsconfig.base.json libs/operaciones/pumping/prisma/seed.ts",
    "db:migrate:fcr": "cd libs/operaciones/fcr && prisma migrate deploy",
    "db:seed:fcr": "tsx --tsconfig tsconfig.base.json libs/operaciones/fcr/prisma/seed.ts",
    "db:seed:comercial": "tsx --tsconfig tsconfig.base.json libs/comercial/pedidos/prisma/seed.ts",
    "db:migrate:archivos": "cd libs/plataforma/archivos && prisma migrate deploy",
    "db:seed:archivos": "tsx --tsconfig tsconfig.base.json libs/plataforma/archivos/prisma/seed.ts",
    "db:migrate:integraciones": "cd libs/plataforma/integraciones && prisma migrate deploy",
    "db:seed:integraciones": "tsx --tsconfig tsconfig.base.json libs/plataforma/integraciones/prisma/seed.ts",
    "db:migrate:catalogos": "cd libs/plataforma/catalogos && prisma migrate deploy",
    "db:seed:catalogos": "tsx --tsconfig tsconfig.base.json libs/plataforma/catalogos/prisma/seed.ts",
    "db:migrate-demo:catalogos": "tsx --tsconfig tsconfig.base.json libs/plataforma/catalogos/prisma/migrate-from-demo.ts"
  },
  "workspaces": [],
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.7",
    "@nx/eslint": "^23.2.0",
    "@nx/eslint-plugin": "23.2.0",
    "@nx/jest": "^23.2.0",
    "@nx/js": "^23.2.0",
    "@nx/nest": "^23.2.0",
    "@nx/node": "^23.2.0",
    "@nx/web": "23.2.0",
    "@nx/webpack": "^23.2.0",
    "@swc/helpers": "~0.5.18",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "lint-staged": "^17.6.0",
    "nx": "23.2.0",
    "prettier": "^3.8.1",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "10.9.1",
    "tslib": "^2.8.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.34.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-express": "^11.2.7",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-express": "^0.71.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/nodemailer": "^8.0.2",
    "amqplib": "^2.2.0",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.7",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^3.0.7",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  }
}
