{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "importHelpers": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "baseUrl": ".",
    "paths": {
      "@dyn/config": ["./libs/shared/config/src/index.ts"],
      "@dyn/utils": ["./libs/shared/utils/src/index.ts"],
      "@dyn/common": ["./libs/shared/common/src/index.ts"],
      "@dyn/authz": ["./libs/shared/authz/src/index.ts"],
      "@dyn/messaging": ["./libs/shared/messaging/src/index.ts"],
      "@dyn/identidad": ["./libs/plataforma/identidad/src/index.ts"],
      "@dyn/catalogos": ["./libs/plataforma/catalogos/src/index.ts"],
      "@dyn/archivos": ["./libs/plataforma/archivos/src/index.ts"],
      "@dyn/integraciones": ["./libs/plataforma/integraciones/src/index.ts"],
      "@dyn/pedidos": ["./libs/comercial/pedidos/src/index.ts"],
      "@dyn/pumping": ["./libs/operaciones/pumping/src/index.ts"],
      "@dyn/fcr": ["./libs/operaciones/fcr/src/index.ts"],
      "@dyn/qhse": ["./libs/qhse/seguridad/src/index.ts"],
      "@dyn/flota": ["./libs/operaciones/flota/src/index.ts"],
      "@dyn/mantenimiento": ["./libs/operaciones/mantenimiento/src/index.ts"],
      "@dyn/inventario": ["./libs/operaciones/inventario/src/index.ts"],
      "@dyn/avisos": ["./libs/plataforma/avisos/src/index.ts"],
      "@dyn/auditoria": ["./libs/plataforma/auditoria/src/index.ts"],
      "@dyn/firmas": ["./libs/plataforma/firmas/src/index.ts"],
      "@dyn/encuestas": ["./libs/plataforma/encuestas/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
