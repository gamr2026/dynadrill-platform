// Módulo `pedidos` (contenedor comercial). Schema PostgreSQL: comercial.
// Diseño: documentacion/database/PLAN-PEDIDO-VENTAS-Y-SECUENCIALES.md (§5) y PLAN-MIGRACION-PEDIDOS.md.
// Las IDs son UUIDv7 generados por la aplicación (sin DEFAULT en la base). El cliente se genera dentro del módulo
// y nadie más lo importa. Migraciones: dyn_migrator, directo a PostgreSQL (ver prisma.config.ts).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["comercial", "catalogos", "identidad", "archivos"]
}

/// Qué documentos existen en el ciclo comercial y cómo se numeran (pedido, prefactura, guía, AOT...).
model Documento {
  id          String  @id @db.Uuid
  /// Código interno estable: `pedido`, `pedido_cliente_as2`, `prefactura`... (minúsculas y guion bajo).
  codigo      String  @unique
  nombre      String
  /// Nombre del documento en AS2 (p. ej. `PEDIDOS CLIENTES`) para conciliar secuencias.
  nombreAs2   String? @map("nombre_as2")
  /// true: el portal emite el número. false: lo asigna AS2 y el portal solo lo refleja (como `PEC-`).
  emitePortal Boolean @default(true) @map("emite_portal")
  activo      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  secuencias Secuencia[]

  @@map("documento")
  @@schema("comercial")
}

/// Contador de un documento. Un documento puede tener varias (por año, por vigencia...), pero solo una activa por
/// documento y año (índice parcial en la migración). Emitir un número es un `UPDATE ... RETURNING` atómico.
model Secuencia {
  id          String    @id @db.Uuid
  documentoId String    @map("documento_id") @db.Uuid
  documento   Documento @relation(fields: [documentoId], references: [id])

  prefijo      String?
  sufijo       String?
  /// Largo total del código incluyendo prefijo y sufijo (como AS2: `PEC-` + 6 dígitos = 10). 0 = sin relleno de ceros.
  longitud     Int     @default(0)
  rangoDesde   Int     @default(1) @map("rango_desde")
  rangoHasta   Int     @default(999999) @map("rango_hasta")
  /// Último número emitido. El siguiente es `numero_actual + 1`.
  numeroActual Int     @default(0) @map("numero_actual")

  /// Informativas: AS2 emite pedidos con vigencia vencida desde 2020, así que no se hace cumplir salvo que se active.
  vigenciaDesde        DateTime? @map("vigencia_desde") @db.Date
  vigenciaHasta        DateTime? @map("vigencia_hasta") @db.Date
  /// Número de autorización del SRI del bloque de documentos (la guía lo imprime junto a su vigencia).
  autorizacionNumero   String?   @map("autorizacion_numero")
  hacerCumplirVigencia Boolean   @default(false) @map("hacer_cumplir_vigencia")

  /// 'nunca' o 'anual' (con `anio`).
  reinicio ReinicioSecuencia @default(nunca)
  anio     Int?

  /// 'portal' (emite el portal) o 'as2' (espejo de la secuencia de AS2).
  origen            OrigenRegistro @default(portal)
  /// Último valor leído de AS2 para esta secuencia (solo origen 'as2').
  as2NumeroActual   Int?      @map("as2_numero_actual")
  as2SincronizadoAt DateTime? @map("as2_sincronizado_at") @db.Timestamptz(6)

  activa  Boolean @default(true)
  version Int     @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  emisiones SecuenciaEmision[]

  @@index([documentoId])
  @@map("secuencia")
  @@schema("comercial")
}

/// Bitácora inmutable de cada número emitido (solo inserción). La restricción única `(secuencia_id, numero)` es la
/// garantía contra duplicados; el estado permite ver anulaciones y números sin documento.
model SecuenciaEmision {
  id          String    @id @db.Uuid
  secuenciaId String    @map("secuencia_id") @db.Uuid
  secuencia   Secuencia @relation(fields: [secuenciaId], references: [id])

  numero           Int
  codigoFormateado String   @map("codigo_formateado")
  /// Id del documento (pedido, prefactura...) que recibió el número; nulo si aún no se asignó.
  documentoRefId   String?  @map("documento_ref_id") @db.Uuid
  /// 'emitido' | 'anulado' | 'huerfano' (CHECK en la migración).
  estado           EstadoEmision @default(emitido)
  emitidoPor       String?  @map("emitido_por") @db.Uuid
  emitidoAt        DateTime @default(now()) @map("emitido_at") @db.Timestamptz(6)
  motivo           String?

  @@unique([secuenciaId, numero])
  @@index([documentoRefId])
  @@map("secuencia_emision")
  @@schema("comercial")
}

// ---------------------------------------------------------------------------------------------------------------
// Estados por proceso (catálogo + transiciones + seguimiento). Un mismo motor sirve a todos los procesos del
// contenedor (pedido, prefactura, AOT...). Las precondiciones de negocio siguen en código y se referencian por nombre
// (`regla`); aquí vive lo que cambia sin desplegar: qué estados hay, cómo se llaman, quién responde y qué pasos son válidos.
// ---------------------------------------------------------------------------------------------------------------

model ProcesoEstado {
  id             String  @id @db.Uuid
  proceso        String
  codigo         String
  nombre         String
  /// 'borrador' | 'pendiente' | 'en_proceso' | 'esperando_aprobacion' | 'aprobado' | 'rechazado' (CHECK en la migración).
  macroEstado    MacroEstado @map("macro_estado")
  orden          Int     @default(0)
  /// Rol del portal que responde en este estado, o 'cliente' (espera externa); nulo = sin responsable.
  rolResponsable String? @map("rol_responsable")
  terminal       Boolean @default(false)
  activo         Boolean @default(true)

  origenes ProcesoTransicion[] @relation("origen")
  destinos ProcesoTransicion[] @relation("destino")
  pedidos  Pedido[]

  @@unique([proceso, codigo])
  @@map("proceso_estado")
  @@schema("comercial")
}

model ProcesoTransicion {
  id            String        @id @db.Uuid
  proceso       String
  estadoOrigen  String        @map("estado_origen")
  estadoDestino String        @map("estado_destino")
  origen        ProcesoEstado @relation("origen", fields: [proceso, estadoOrigen], references: [proceso, codigo])
  destino       ProcesoEstado @relation("destino", fields: [proceso, estadoDestino], references: [proceso, codigo])

  /// Permiso que debe tener quien dispara el paso a mano; nulo = no hay paso manual (solo el sistema o un forzado).
  permiso          String?
  requiereMotivo   Boolean @default(false) @map("requiere_motivo")
  /// true: lo dispara un hecho (evento o sincronización). El paso manual solo existe si tiene `permiso`.
  automatica       Boolean @default(false)
  eventoDisparador String? @map("evento_disparador")
  /// Nombre de una precondición de negocio implementada en código (p. ej. `avance_documental_completo`).
  regla            String?
  activa           Boolean @default(true)

  @@unique([proceso, estadoOrigen, estadoDestino])
  @@map("proceso_transicion")
  @@schema("comercial")
}

/// Seguimiento inmutable de cada cambio de estado de cualquier proceso (solo inserción).
model ProcesoHistorial {
  id             String   @id @db.Uuid
  proceso        String
  entidadId      String   @map("entidad_id") @db.Uuid
  estadoAnterior String?  @map("estado_anterior")
  estadoNuevo    String   @map("estado_nuevo")
  macroEstado    MacroEstado? @map("macro_estado")
  motivo         String?
  actorId        String?  @map("actor_id") @db.Uuid
  actor          IdUsuario? @relation("historialActor", fields: [actorId], references: [id])
  actorRol       String?  @map("actor_rol")
  /// 'manual' | 'automatico' | 'sincronizacion' | 'forzado' | 'sistema' (CHECK en la migración).
  origen         OrigenCambioEstado @default(manual)
  eventoId       String?  @map("evento_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([proceso, entidadId, createdAt])
  @@map("proceso_historial")
  @@schema("comercial")
}

// ---------------------------------------------------------------------------------------------------------------
// Pedido: entidad ancla del ciclo comercial. Los datos de catálogo y de personas son FK reales a `catalogos` e `identidad`
// (el nombre sale del JOIN: no se copia). Los documentos emitidos (guía, orden de trabajo, prefactura firmada) sí conservan
// lo que decían al emitirse.
// ---------------------------------------------------------------------------------------------------------------

/// El ticket de Operaciones del pedido y el paso en que va (solo el código; el nombre es del catálogo de Operaciones).
model PedidoTicketOperativo {
  pedidoId      String          @id @map("pedido_id") @db.Uuid
  pedido        Pedido          @relation(fields: [pedidoId], references: [id])
  origen        OrigenOperativo
  ticketId      String          @map("ticket_id") @db.Uuid
  pasoCodigo    String          @map("paso_codigo")
  actualizadoAt DateTime        @default(now()) @map("actualizado_at") @db.Timestamptz(6)

  @@map("pedido_ticket_operativo")
  @@schema("comercial")
}

model Pedido {
  /// El ticket de Operaciones que lo atiende (si ya se abrió).
  ticketOperativo PedidoTicketOperativo?
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid
  /// Control optimista de concurrencia: cada edición exige la versión que vio quien edita.
  version   Int      @default(1)

  /// Código propio del portal (secuencia `pedido`). Nulo mientras es borrador; se emite al abrir.
  codigo String? @unique

  /// 'portal' (creado por Ventas) | 'as2' (cargado desde AS2).
  origen             OrigenRegistro
  as2IdPedidoCliente Int?      @unique @map("as2_id_pedido_cliente")
  /// `PEC-00xxxx`, el número que AS2 asignó.
  as2Numero          String?   @map("as2_numero")
  as2Estado          String?   @map("as2_estado")
  as2Fecha           DateTime? @map("as2_fecha") @db.Date
  /// Montos de cabecera de AS2: `total` es el subtotal bruto; el final es `total - descuento + impuesto`.
  as2Total           Decimal?  @map("as2_total") @db.Decimal(14, 2)
  as2Descuento       Decimal?  @map("as2_descuento") @db.Decimal(14, 2)
  as2Impuesto        Decimal?  @map("as2_impuesto") @db.Decimal(14, 2)
  as2Descripcion     String?   @map("as2_descripcion")
  /// 'no_aplica' | 'pendiente_de_crear_en_as2' | 'vinculado' | 'error' (CHECK en la migración).
  as2SyncEstado      EstadoSyncAs2 @default(no_aplica) @map("as2_sync_estado")
  /// 'referencia_en_descripcion' | 'manual' | 'api' (cómo se vinculó un pedido del portal con el de AS2).
  as2VinculoMetodo   MetodoVinculoAs2? @map("as2_vinculo_metodo")
  as2SincronizadoAt  DateTime? @map("as2_sincronizado_at") @db.Timestamptz(6)

  // --- cliente y servicio
  clienteId     String?     @map("cliente_id") @db.Uuid
  cliente       CatCliente? @relation(fields: [clienteId], references: [id])
  subcliente    String?
  /// 'fcr' | 'pumping'
  lineaId       String?        @map("linea_id") @db.Uuid
  linea         ServicioLinea? @relation(fields: [lineaId], references: [id])
  /// Tipo de OT (catálogo `tipo_ot`: venta | servicio)
  tipoOtId      String?  @map("tipo_ot_id") @db.Uuid
  tipoOt        TipoOt?  @relation(fields: [tipoOtId], references: [id])

  // --- ubicación (FK a los catálogos; la zona es la del campo); `rigless` = trabajo sin taladro
  campoId        String?     @map("campo_id") @db.Uuid
  campo          CatCampo?   @relation(fields: [campoId], references: [id])
  bloqueId       String?     @map("bloque_id") @db.Uuid
  bloque         CatBloque?  @relation(fields: [bloqueId], references: [id])
  pozoId         String?     @map("pozo_id") @db.Uuid
  pozo           CatPozo?    @relation(fields: [pozoId], references: [id])
  taladroId      String?     @map("taladro_id") @db.Uuid
  taladro        CatTaladro? @relation(fields: [taladroId], references: [id])
  rigless        Boolean @default(false)
  numeroContrato String? @map("numero_contrato")

  // --- estado (catálogo `proceso_estado`)
  proceso         String        @default("pedido")
  estado          String        @default("borrador")
  estadoRef       ProcesoEstado @relation(fields: [proceso, estado], references: [proceso, codigo])
  motivoAnulacion String?       @map("motivo_anulacion")
  anuladoAt       DateTime?     @map("anulado_at") @db.Timestamptz(6)

  // --- responsables (FK a `identidad.usuario`; los representantes, a `catalogos.persona_contacto`). El analista de
  // facturación NO se asigna al crear.
  agenteComercialId         String?   @map("agente_comercial_id") @db.Uuid
  agenteComercial           IdUsuario? @relation("pedidoAgente", fields: [agenteComercialId], references: [id])
  representanteCampoId      String?   @map("representante_campo_id") @db.Uuid
  representanteCampo        CatPersona? @relation("pedidoRepCampo", fields: [representanteCampoId], references: [id])
  representanteQuitoId      String?   @map("representante_quito_id") @db.Uuid
  representanteQuito        CatPersona? @relation("pedidoRepQuito", fields: [representanteQuitoId], references: [id])
  tecnicoHseId              String?   @map("tecnico_hse_id") @db.Uuid
  tecnicoHse                IdUsuario? @relation("pedidoHse", fields: [tecnicoHseId], references: [id])
  analistaFacturacionId     String?   @map("analista_facturacion_id") @db.Uuid
  analistaFacturacion       IdUsuario? @relation("pedidoAnalista", fields: [analistaFacturacionId], references: [id])
  /// FK a `identidad.usuario` (solo en la base de datos).
  analistaAsignadoPor       String?   @map("analista_asignado_por") @db.Uuid
  analistaAsignadoAt        DateTime? @map("analista_asignado_at") @db.Timestamptz(6)

  // --- sección administrativa
  /// Condición de pago y bodega: FK a los catálogos. La zona no se guarda: es la del campo.
  condicionPagoId     String?        @map("condicion_pago_id") @db.Uuid
  condicionPago       CatCondicionPago? @relation(fields: [condicionPagoId], references: [id])
  bodegaId            String?        @map("bodega_id") @db.Uuid
  bodega              CatBodega?     @relation(fields: [bodegaId], references: [id])
  /// Lo que AS2 trae del pedido cuando no tiene su registro en nuestro catálogo (se conserva como dato de AS2 hasta conciliarlo).
  as2EmpresaNombre         String? @map("as2_empresa_nombre")
  as2EmpresaIdentificacion String? @map("as2_empresa_identificacion")
  as2Bodega                String? @map("as2_bodega")
  as2CondicionPago         String? @map("as2_condicion_pago")
  as2Zona                  String? @map("as2_zona")
  /// 'verbal' | 'escrita'
  solicitudMedio      SolicitudMedio? @map("solicitud_medio")
  fechaInicioServicio DateTime? @map("fecha_inicio_servicio") @db.Date
  fechaFinServicio    DateTime? @map("fecha_fin_servicio") @db.Date

  tiposServicio    PedidoTipoServicio[]
  items            PedidoItem[]
  documentos       PedidoDocumento[]
  documentosOperativos DocumentoOperativo[]
  /// Despacho a Bodega: solo dos momentos (solicitado por Facturación, realizado por Bodega), sin documento.
  /// Número de ticket: el MISMO que tendrá la prefactura (el "ticket" de Dynadrill es la prefactura). Se toma del secuencial de la
  /// prefactura al abrir el pedido por primera vez; la prefactura, cuando exista, lleva este mismo número.
  ticketNumero     Int?    @unique @map("ticket_numero")
  ticketEmisionId  String? @map("ticket_emision_id") @db.Uuid
  /// Factura de AS2 con la que se cerró el pedido.
  facturaNumero String?   @map("factura_numero")
  facturadoAt   DateTime? @map("facturado_at") @db.Timestamptz(6)
  facturadoPor  String?   @map("facturado_por") @db.Uuid
  despachoSolicitadoAt     DateTime? @map("despacho_solicitado_at") @db.Timestamptz(6)
  despachoSolicitadoPor    String?   @map("despacho_solicitado_por") @db.Uuid
  despachoSolicitante      IdUsuario? @relation("pedidoDespachoSolicitado", fields: [despachoSolicitadoPor], references: [id])
  despachoRealizadoAt      DateTime? @map("despacho_realizado_at") @db.Timestamptz(6)
  despachoRealizadoPor     String?   @map("despacho_realizado_por") @db.Uuid
  despachoEjecutor         IdUsuario? @relation("pedidoDespachoRealizado", fields: [despachoRealizadoPor], references: [id])
  /// Bodega adjunta el documento de respaldo (obligatorio al realizar el despacho) y, si despacha químicos, la hoja MSDS.
  despachoArchivoRespaldoId String?  @map("despacho_archivo_respaldo_id") @db.Uuid
  despachoArchivoMsdsId     String?  @map("despacho_archivo_msds_id") @db.Uuid
  prefacturas      Prefactura[]
  guias            GuiaRemision[]
  ordenTrabajo     OrdenTrabajo?

  @@index([estado])
  @@index([clienteId])
  @@index([lineaId, estado])
  @@index([analistaFacturacionId])
  @@map("pedido")
  @@schema("comercial")
}

/// Catálogo de líneas de servicio (FCR, Pumping...). Cada tabla tiene `id` UUID; las claves foráneas van por `id`.
model ServicioLinea {
  id     String  @id @db.Uuid
  codigo String  @unique
  nombre String
  orden  Int     @default(0)
  activo Boolean @default(true)

  tipos   ServicioTipo[]
  pedidos Pedido[]

  @@map("servicio_linea")
  @@schema("comercial")
}

/// Catálogo de tipos de servicio: cada uno pertenece a una línea.
model ServicioTipo {
  id      String        @id @db.Uuid
  lineaId String        @map("linea_id") @db.Uuid
  linea   ServicioLinea @relation(fields: [lineaId], references: [id])
  codigo  String        @unique
  nombre  String
  orden   Int           @default(0)
  activo  Boolean       @default(true)

  subtipos    ServicioSubtipo[]
  pedidoTipos PedidoTipoServicio[]

  @@index([lineaId])
  @@map("servicio_tipo")
  @@schema("comercial")
}

/// Catálogo de subtipos: cada subtipo pertenece a UN tipo (1:n). El mismo nombre puede existir bajo tipos distintos.
model ServicioSubtipo {
  id     String       @id @db.Uuid
  tipoId String       @map("tipo_id") @db.Uuid
  tipo   ServicioTipo @relation(fields: [tipoId], references: [id])
  nombre String
  orden  Int          @default(0)
  activo Boolean      @default(true)

  pedidoSubtipos PedidoSubtipoServicio[]

  @@unique([tipoId, nombre])
  @@unique([tipoId, id])
  @@map("servicio_subtipo")
  @@schema("comercial")
}

/// Tipo de servicio elegido en un pedido.
model PedidoTipoServicio {
  id       String       @id @db.Uuid
  pedidoId String       @map("pedido_id") @db.Uuid
  pedido   Pedido       @relation(fields: [pedidoId], references: [id])
  tipoId   String       @map("tipo_id") @db.Uuid
  tipo     ServicioTipo @relation(fields: [tipoId], references: [id])

  subtipos PedidoSubtipoServicio[]

  @@unique([pedidoId, tipoId])
  @@map("pedido_tipo_servicio")
  @@schema("comercial")
}

/// Subtipo elegido en un pedido. Cuelga de un tipo que el MISMO pedido tiene elegido (FK compuesta) y de un subtipo que
/// pertenece a ESE tipo (FK compuesta al catálogo). Sin FK directa a pedido: queda garantizado a través del tipo.
model PedidoSubtipoServicio {
  id         String             @id @db.Uuid
  pedidoId   String             @map("pedido_id") @db.Uuid
  tipoId     String             @map("tipo_id") @db.Uuid
  subtipoId  String             @map("subtipo_id") @db.Uuid
  pedidoTipo PedidoTipoServicio @relation(fields: [pedidoId, tipoId], references: [pedidoId, tipoId])
  catalogo   ServicioSubtipo    @relation(fields: [tipoId, subtipoId], references: [tipoId, id])

  @@unique([pedidoId, subtipoId])
  @@map("pedido_subtipo_servicio")
  @@schema("comercial")
}

/// Ítem estimado. Los de un pedido nuevo salen SIEMPRE de la lista de precios del cliente (`lista_precios_item_id`).
model PedidoItem {
  id                 String            @id @db.Uuid
  pedidoId           String            @map("pedido_id") @db.Uuid
  pedido             Pedido            @relation(fields: [pedidoId], references: [id])
  orden              Int               @db.SmallInt
  codigo             String
  descripcion        String
  unidad             String
  cantidad           Decimal           @db.Decimal(12, 3)
  valorUnitario      Decimal           @map("valor_unitario") @db.Decimal(14, 2)
  descuentoPct       Decimal?          @map("descuento_pct") @db.Decimal(5, 2)
  /// 'lista' (de la lista de precios) | 'plantilla' (Excel de AS2) | 'as2' (líneas importadas de AS2) | 'manual' (precio autorizado a mano)
  origenItem         OrigenItem @default(lista) @map("origen_item")
  listaPreciosItemId String?           @map("lista_precios_item_id") @db.Uuid
  listaPreciosItem   ListaPreciosItem? @relation(fields: [listaPreciosItemId], references: [id])
  /// Cómo se trata la línea: `material` (incluye químicos de Inventario), `servicio`, `herramienta` (FCR) o `movilizacion`.
  tipoLinea          TipoLinea         @default(servicio) @map("tipo_linea")

  @@unique([pedidoId, orden])
  @@map("pedido_item")
  @@schema("comercial")
}

// ---------------------------------------------------------------------------------------------------------------
// Listas de precios (por cliente y contrato). De aquí salen los ítems de un pedido.
// ---------------------------------------------------------------------------------------------------------------

model ListaPrecios {
  id             String   @id @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?  @map("updated_by") @db.Uuid
  clienteId      String?  @map("cliente_id") @db.Uuid
  cliente        CatCliente? @relation(fields: [clienteId], references: [id])
  numeroContrato String   @map("numero_contrato")
  vigenteDesde   DateTime @map("vigente_desde") @db.Date
  activa         Boolean  @default(true)
  /// El cliente de este contrato exige la orden de trabajo (OT) después de la prefactura firmada.
  requiereOrdenTrabajo Boolean @default(false) @map("requiere_orden_trabajo")
  /// Párrafo del contrato que la OT imprime (fijo por contrato).
  textoContrato        String? @map("texto_contrato")
  /// id numérico de la demo, solo para trazar la migración inicial de listas.
  legacyId       Int?     @unique @map("legacy_id")

  items ListaPreciosItem[]

  @@index([clienteId, activa])
  @@map("lista_precios")
  @@schema("comercial")
}

model ListaPreciosItem {
