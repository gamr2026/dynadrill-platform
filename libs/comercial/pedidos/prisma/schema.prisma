/// Prefactura del pedido. Se calcula con la lista de precios, los reportes operativos y los ítems del pedido. Cada
/// regeneración tras un rechazo es una VERSIÓN nueva; las anteriores se conservan. `ticket_numero` es el número que AS2
/// asigna a la prefactura (PRC-) y que Dynadrill usa como número de ticket; se registra cuando AS2 lo entrega.
model Prefactura {
  id                   String           @id @db.Uuid
  pedidoId             String           @map("pedido_id") @db.Uuid
  pedido               Pedido           @relation(fields: [pedidoId], references: [id])
  version              Int              @default(1)
  estado               EstadoPrefactura @default(generada)
  ticketNumero         Int?             @map("ticket_numero")
  listaPreciosId       String?          @map("lista_precios_id") @db.Uuid
  subtotalServicios    Decimal          @map("subtotal_servicios") @db.Decimal(14, 2)
  subtotalMateriales   Decimal          @map("subtotal_materiales") @db.Decimal(14, 2)
  subtotal             Decimal          @db.Decimal(14, 2)
  iva                  Decimal          @db.Decimal(14, 2)
  retencionIr          Decimal          @map("retencion_ir") @db.Decimal(14, 2)
  retencionIva         Decimal          @map("retencion_iva") @db.Decimal(14, 2)
  netoCobrar           Decimal          @map("neto_cobrar") @db.Decimal(14, 2)
  ivaPct               Decimal          @map("iva_pct") @db.Decimal(5, 2)
  retencionIrPct       Decimal          @map("retencion_ir_pct") @db.Decimal(5, 2)
  retencionIvaPct      Decimal          @map("retencion_iva_pct") @db.Decimal(5, 2)
  generadaAt           DateTime         @default(now()) @map("generada_at") @db.Timestamptz(6)
  generadaPor          String           @map("generada_por") @db.Uuid
  enviadaAt            DateTime?        @map("enviada_at") @db.Timestamptz(6)
  enviadaPor           String?          @map("enviada_por") @db.Uuid
  medioEnvio           MedioEnvioPrefactura? @map("medio_envio")
  /// Por qué se tardó en firmar (cuando aplica).
  razonRetraso         String?          @map("razon_retraso")
  firmadaAt            DateTime?        @map("firmada_at") @db.Timestamptz(6)
  rechazadaAt          DateTime?        @map("rechazada_at") @db.Timestamptz(6)
  rechazadaPor         String?          @map("rechazada_por") @db.Uuid
  rechazoMotivo        String?          @map("rechazo_motivo")
  rechazoDevueltoA     AreaDevolucion?  @map("rechazo_devuelto_a")
  anuladaAt            DateTime?        @map("anulada_at") @db.Timestamptz(6)
  anuladaPor           String?          @map("anulada_por") @db.Uuid
  anulacionMotivo      String?          @map("anulacion_motivo")

  items        PrefacturaItem[]
  advertencias PrefacturaAdvertencia[]
  firmas       PrefacturaFirma[]

  @@unique([pedidoId, version])
  @@index([pedidoId])
  @@map("prefactura")
  @@schema("comercial")
}

model PrefacturaItem {
  id             String               @id @db.Uuid
  prefacturaId   String               @map("prefactura_id") @db.Uuid
  prefactura     Prefactura           @relation(fields: [prefacturaId], references: [id], onDelete: Cascade)
  orden          Int
  codigo         String
  descripcion    String
  unidad         String?
  serie          String?
  cantidad       Decimal              @db.Decimal(14, 3)
  precioUnitario Decimal              @map("precio_unitario") @db.Decimal(14, 2)
  descuentoPct   Decimal              @default(0) @map("descuento_pct") @db.Decimal(5, 2)
  precioTotal    Decimal              @map("precio_total") @db.Decimal(14, 2)
  tipo           TipoItemLista
  fuente         FuenteItemPrefactura

  @@unique([prefacturaId, orden])
  @@map("prefactura_item")
  @@schema("comercial")
}

/// Aviso al calcular (p. ej. una herramienta sin código o sin coincidencia en la lista) para que Facturación lo revise.
model PrefacturaAdvertencia {
  id           String     @id @db.Uuid
  prefacturaId String     @map("prefactura_id") @db.Uuid
  prefactura   Prefactura @relation(fields: [prefacturaId], references: [id], onDelete: Cascade)
  orden        Int
  mensaje      String

  @@unique([prefacturaId, orden])
  @@map("prefactura_advertencia")
  @@schema("comercial")
}

/// Firma de la prefactura: quién firmó (company man del pedido, cliente o Dynadrill), con el archivo firmado.
model PrefacturaFirma {
  id            String            @id @db.Uuid
  prefacturaId  String            @map("prefactura_id") @db.Uuid
  prefactura    Prefactura        @relation(fields: [prefacturaId], references: [id], onDelete: Cascade)
  firmanteTipo  TipoFirmante      @map("firmante_tipo")
  /// Persona del catálogo (representante de campo o de Quito), si es una; sin FK entre schemas.
  personaId     String?           @map("persona_id") @db.Uuid
  nombre        String
  cargo         String?
  firmadoAt     DateTime          @map("firmado_at") @db.Date
  archivoId     String            @map("archivo_id") @db.Uuid
  archivo       CatArchivo        @relation(fields: [archivoId], references: [id])
  verificacion  VerificacionFirma @default(no_verificada)
  /// Confianza de la lectura (0 a 1; no es una probabilidad calibrada) y cuándo se intentó. Con `verificacion_at` y
  /// resultado `no_verificada`, el intento no pudo completarse (servicio no disponible).
  verificacionConfianza Decimal? @map("verificacion_confianza") @db.Decimal(4, 3)
  verificacionAt        DateTime? @map("verificacion_at") @db.Timestamptz(6)
  /// `null` si no se comparó el nombre; si no, si apareció junto a la firma.
  nombreCoincide        Boolean?  @map("nombre_coincide")
  registradoPor String            @map("registrado_por") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([prefacturaId, archivoId])
  @@index([prefacturaId])
  @@map("prefactura_firma")
  @@schema("comercial")
}

enum EstadoGuia {
  emitida
  anulada

  @@map("estado_guia")
  @@schema("comercial")
}

enum OrigenItemGuia {
  herramienta
  material
  manual

  @@map("origen_item_guia")
  @@schema("comercial")
}

/// Lugares desde donde se despacha (p. ej. la base de Dynadrill).
model LugarDespacho {
  id     String  @id @db.Uuid
  nombre String  @unique
  activo Boolean @default(true)

  guias GuiaRemision[]

  @@map("lugar_despacho")
  @@schema("comercial")
}

/// Guía de remisión del pedido: lo que sale físicamente de bodega (herramientas con su serie y materiales). El portal la
/// numera con su secuencial (`003-001-0011036`; el número se puede reasignar con motivo), genera el PDF y Facturación lo
/// firma electrónicamente; el archivo firmado se adjunta desde `archivos`. No es la guía electrónica del SRI.
model GuiaRemision {
  id            String     @id @db.Uuid
  pedidoId      String     @map("pedido_id") @db.Uuid
  pedido        Pedido     @relation(fields: [pedidoId], references: [id])
  numero        Int
  /// Código formateado (`003-001-0011036`); no se repite.
  codigo        String     @unique
  /// Emisión vigente del número en la bitácora de secuenciales.
  emisionId     String     @map("emision_id") @db.Uuid
  estado        EstadoGuia @default(emitida)
  fecha         DateTime   @db.Date
  clienteNombre String?    @map("cliente_nombre")
  clienteRuc    String?    @map("cliente_ruc")
  lugarOrigenId String     @map("lugar_origen_id") @db.Uuid
  lugarOrigen   LugarDespacho @relation(fields: [lugarOrigenId], references: [id])
  /// Quién solicita y quién despacha, tal como se imprimió en la guía (documento emitido: texto, no un vínculo).
  solicitadoPorNombre String? @map("solicitado_por_nombre")
  despachadoPorNombre String? @map("despachado_por_nombre")
  /// 'HH:mm'
  horaSalida    String?    @map("hora_salida")
  horaLlegada   String?    @map("hora_llegada")
  /// Transporte: el id es FK al catálogo (solo en la base de datos); el nombre y la identificación se conservan tal como se emitió.
  transportistaId             String  @map("transportista_id") @db.Uuid
  transportistaNombre         String  @map("transportista_nombre")
  transportistaIdentificacion String  @map("transportista_identificacion")
  vehiculoId     String? @map("vehiculo_id") @db.Uuid
  placa          String?
  /// Tipo, marca y modelo del vehículo al emitir (p. ej. "CAMION JAC HFC1040K2"): copia, el catálogo puede cambiar.
  vehiculoDescripcion String? @map("vehiculo_descripcion")
  choferId       String? @map("chofer_id") @db.Uuid
  choferNombre   String? @map("chofer_nombre")
  observaciones  String?
  /// Si reemplaza a otra guía de este pedido (p. ej. por un error).
  reemplazaAId   String?       @map("reemplaza_a_id") @db.Uuid
  reemplazaA     GuiaRemision? @relation("reemplazo", fields: [reemplazaAId], references: [id])
  reemplazadaPor GuiaRemision[] @relation("reemplazo")
  emitidaAt      DateTime   @default(now()) @map("emitida_at") @db.Timestamptz(6)
  emitidaPor     String     @map("emitida_por") @db.Uuid
  anuladaAt      DateTime?  @map("anulada_at") @db.Timestamptz(6)
  anuladaPor     String?    @map("anulada_por") @db.Uuid
  anulacionMotivo String?   @map("anulacion_motivo")
  /// Guía firmada electrónicamente (archivo en el módulo `archivos`).
  archivoFirmadoId     String?     @map("archivo_firmado_id") @db.Uuid
  archivoFirmado       CatArchivo? @relation("guiaArchivo", fields: [archivoFirmadoId], references: [id])
  firmadaAt            DateTime? @map("firmada_at") @db.Timestamptz(6)
  /// Validación criptográfica de las firmas digitales del PDF firmado (servicio firmas-ocr). Ayuda para revisar: sin
  /// revocación y con las raíces cargadas, un firmante puede salir "no verificado". Nunca bloquea el registro.
  /// Lectura de la firma manuscrita (OpenCV + Tesseract), como en la prefactura: ayuda para revisar, nunca certifica.
  firmaManuscrita          VerificacionFirma @default(no_verificada) @map("firma_manuscrita")
  firmaManuscritaConfianza Decimal?          @map("firma_manuscrita_confianza") @db.Decimal(4, 3)
  firmaManuscritaAt        DateTime?         @map("firma_manuscrita_at") @db.Timestamptz(6)
  firmaElectronicaEstado  EstadoFirmaElectronica? @map("firma_electronica_estado")
  firmaElectronicaResumen String?                 @map("firma_electronica_resumen")
  firmaElectronicaAt      DateTime?               @map("firma_electronica_at") @db.Timestamptz(6)

  items          GuiaRemisionItem[]
  firmasDigitales GuiaFirmaDigital[]

  @@index([pedidoId])
  @@map("guia_remision")
  @@schema("comercial")
}

model GuiaRemisionItem {
  id          String         @id @db.Uuid
  guiaId      String         @map("guia_id") @db.Uuid
  guia        GuiaRemision   @relation(fields: [guiaId], references: [id], onDelete: Cascade)
  orden       Int
  codigo      String?
  descripcion String
  cantidad    Decimal        @db.Decimal(14, 3)
  unidad      String
  serie       String?
  origen      OrigenItemGuia

  @@unique([guiaId, orden])
  @@map("guia_remision_item")
  @@schema("comercial")
}

enum EstadoFirmaElectronica {
  sin_firmas_digitales
  verificado
  verificado_con_advertencias
  firmantes_no_verificados
  alterado

  @@map("estado_firma_electronica")
  @@schema("comercial")
}

enum IntegridadFirmaDigital {
  intacto
  intacto_con_revisiones_posteriores
  modificado_despues_de_firmar
  firma_invalida

  @@map("integridad_firma_digital")
  @@schema("comercial")
}

enum OrigenFechaFirma {
  sello_de_tiempo
  declarada_por_el_firmante
  desconocida

  @@map("origen_fecha_firma")
  @@schema("comercial")
}

/// Una firma digital encontrada en el PDF firmado de la guía.
model GuiaFirmaDigital {
  id                     String                 @id @db.Uuid
  guiaId                 String                 @map("guia_id") @db.Uuid
  guia                   GuiaRemision           @relation(fields: [guiaId], references: [id], onDelete: Cascade)
  orden                  Int
  firmanteNombre         String?                @map("firmante_nombre")
  firmanteIdentificacion String?                @map("firmante_identificacion")
  emisor                 String?
  integridad             IntegridadFirmaDigital
  firmaValida            Boolean                @map("firma_valida")
  firmanteVerificado     Boolean                @map("firmante_verificado")
  vigenteAlFirmar        Boolean?               @map("vigente_al_firmar")
  fechaFirma             DateTime?              @map("fecha_firma") @db.Timestamptz(6)
  origenFecha            OrigenFechaFirma       @map("origen_fecha")
  conclusion             String

  @@unique([guiaId, orden])
  @@map("guia_firma_digital")
  @@schema("comercial")
}

enum EstadoOrdenTrabajo {
  generada
  firmada

  @@map("estado_orden_trabajo")
  @@schema("comercial")
}

/// Ciudades que lleva el número de la OT (`948-OPR-POZO-UIO-2026`).
model CiudadOt {
  id     String  @id @db.Uuid
  codigo String  @unique
  nombre String
  activo Boolean @default(true)

  ordenes OrdenTrabajo[]

  @@map("ciudad_ot")
  @@schema("comercial")
}

/// Quién firma la OT por Dynadrill (representante de la contratista).
model FirmanteContratista {
  id             String  @id @db.Uuid
  nombre         String
  cargo          String
  predeterminado Boolean @default(false)
  activo         Boolean @default(true)

  @@map("firmante_contratista")
  @@schema("comercial")
}

/// Orden de trabajo / resumen de costos: se genera de la prefactura firmada, solo para los clientes que la requieren
/// (una por pedido). Su número propio no se reinicia: `{n}-OPR-{pozo}-{ciudad}-{año de la OT}`. La firma es física: el
/// portal solo anota quién la marcó como firmada (y el archivo, si se sube).
model OrdenTrabajo {
  id            String       @id @db.Uuid
  pedidoId      String       @unique @map("pedido_id") @db.Uuid
  pedido        Pedido       @relation(fields: [pedidoId], references: [id])
  prefacturaId  String       @map("prefactura_id") @db.Uuid
  numero        Int
  /// `948-OPR-ESTACION NORTE 2-UIO-2026`; no se repite.
  codigo        String       @unique
  emisionId     String       @map("emision_id") @db.Uuid
  ciudadId      String       @map("ciudad_id") @db.Uuid
  ciudad        CiudadOt     @relation(fields: [ciudadId], references: [id])
  anio          Int          @db.SmallInt
  /// Fecha de la OT: un día antes del inicio del servicio.
  fecha         DateTime     @db.Date
  numeroContrato String?     @map("numero_contrato")
  textoContrato String?      @map("texto_contrato")
  descripcionRequerimiento String @map("descripcion_requerimiento")
  /// `descripción /pozo/taladro`
  servicio      String
  fechaInicio   DateTime?    @map("fecha_inicio") @db.Date
  fechaTerminacion DateTime? @map("fecha_terminacion") @db.Date
  valorOt       Decimal      @map("valor_ot") @db.Decimal(14, 2)
  contratistaNombre String   @map("contratista_nombre")
  contratistaCargo  String   @map("contratista_cargo")
  clienteNombre String       @map("cliente_nombre")
  clienteCargo  String       @map("cliente_cargo")
  estado        EstadoOrdenTrabajo @default(generada)
  generadaAt    DateTime     @default(now()) @map("generada_at") @db.Timestamptz(6)
  generadaPor   String       @map("generada_por") @db.Uuid
  firmadaAt     DateTime?    @map("firmada_at") @db.Timestamptz(6)
  firmadaPor    String?      @map("firmada_por") @db.Uuid
  archivoFirmadoId     String?     @map("archivo_firmado_id") @db.Uuid
  archivoFirmado       CatArchivo? @relation("ordenArchivo", fields: [archivoFirmadoId], references: [id])

  items OrdenTrabajoItem[]

  @@map("orden_trabajo")
  @@schema("comercial")
}

model OrdenTrabajoItem {
  id          String       @id @db.Uuid
  ordenId     String       @map("orden_id") @db.Uuid
  orden       OrdenTrabajo @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  orden_      Int          @map("orden")
  codigo      String?
  descripcion String
  unidad      String?
  tarifa      Decimal      @db.Decimal(14, 2)
  cantidad    Decimal      @db.Decimal(14, 3)
  total       Decimal      @db.Decimal(14, 2)

  @@unique([ordenId, orden_])
  @@map("orden_trabajo_item")
  @@schema("comercial")
}

// ---------------------------------------------------------------------------------------------------------------
// Espejos de SOLO LECTURA de tablas de otros módulos (`catalogos`, `identidad`). Sirven para obtener el nombre con JOIN a
// partir de las FK. Este módulo nunca escribe en ellas (`app_comercial` solo tiene SELECT, y de `identidad.usuario` solo
// id, nombre, email y activo). Las administra el módulo dueño de cada tabla.
// ---------------------------------------------------------------------------------------------------------------

model CatCliente {
  id              String  @id @db.Uuid
  identificacion  String
  nombreComercial String  @map("nombre_comercial")
  nombreFiscal    String? @map("nombre_fiscal")

  pedidos       Pedido[]
  listasPrecios ListaPrecios[]

  @@map("cliente")
  @@schema("catalogos")
}

model CatZona {
  id     String     @id @db.Uuid
  nombre String
  campos CatCampo[]

  @@map("zona")
  @@schema("catalogos")
}

model CatCampo {
  id     String   @id @db.Uuid
  nombre String
  zonaId String?  @map("zona_id") @db.Uuid
  zona   CatZona? @relation(fields: [zonaId], references: [id])

  pedidos Pedido[]

  @@map("campo")
  @@schema("catalogos")
}

model CatBloque {
  id     String @id @db.Uuid
  nombre String

  pedidos Pedido[]

  @@map("bloque")
  @@schema("catalogos")
}

model CatPozo {
  id             String @id @db.Uuid
  codigo         String
  nombreCompleto String @map("nombre_completo")

  pedidos Pedido[]

  @@map("pozo")
  @@schema("catalogos")
}

model CatTaladro {
  id     String @id @db.Uuid
  nombre String

  pedidos Pedido[]

  @@map("taladro")
  @@schema("catalogos")
}

model CatBodega {
  id     String @id @db.Uuid
  nombre String

  pedidos Pedido[]

  @@map("bodega")
  @@schema("catalogos")
}

model CatCondicionPago {
  id     String @id @db.Uuid
  nombre String

  pedidos Pedido[]

  @@map("condicion_pago")
  @@schema("catalogos")
}

/// `catalogos.persona_contacto`: representantes de campo y de Quito.
model CatPersona {
  id     String @id @db.Uuid
  nombre String

  comoRepresentanteCampo Pedido[] @relation("pedidoRepCampo")
  comoRepresentanteQuito Pedido[] @relation("pedidoRepQuito")

  @@map("persona_contacto")
  @@schema("catalogos")
}

/// `identidad.usuario`: solo lo que otros módulos pueden ver (nunca la clave ni los datos de acceso).
model IdUsuario {
  id     String  @id @db.Uuid
  nombre String
  email  String
  activo Boolean

  historial          ProcesoHistorial[]   @relation("historialActor")
  comoAgente         Pedido[]             @relation("pedidoAgente")
  comoTecnicoHse     Pedido[]             @relation("pedidoHse")
  comoAnalista       Pedido[]             @relation("pedidoAnalista")
  comoDespachoSolic  Pedido[]             @relation("pedidoDespachoSolicitado")
  comoDespachoReal   Pedido[]             @relation("pedidoDespachoRealizado")
  comoSupervisorDoc  DocumentoOperativo[] @relation("docopSupervisor")
  comoOperadorDoc    DocumentoOperativo[] @relation("docopOperador")

  @@map("usuario")
  @@schema("identidad")
}

/// `archivos.archivo`: espejo de SOLO LECTURA (nombre, tipo, tamaño y quién lo subió; nunca la clave del blob ni el hash).
model CatArchivo {
  id             String @id @db.Uuid
  nombreOriginal String @map("nombre_original")
  mimeType       String @map("mime_type")
  tamanoBytes    BigInt @map("tamano_bytes")
  subidoPor      String @map("subido_por") @db.Uuid

  documentosPedido PedidoDocumento[]
  firmasPrefactura PrefacturaFirma[]
  guias            GuiaRemision[]    @relation("guiaArchivo")
  ordenes          OrdenTrabajo[]    @relation("ordenArchivo")

  @@map("archivo")
  @@schema("archivos")
}
