/// Documento operativo del pedido: un Reporte Job por día o un Reporte de Herramientas por servicio. Lo empuja Operaciones
/// (FCR al aprobar el supervisor; Pumping al guardar el reporte diario). Recibir otro con la misma clave
/// (pedido, tipo, origen, fecha) lo REEMPLAZA. `ticket_ref` es la referencia al ticket en Operaciones (aún sin migrar).
model DocumentoOperativo {
  id               String                 @id @db.Uuid
  pedidoId         String                 @map("pedido_id") @db.Uuid
  pedido           Pedido                 @relation(fields: [pedidoId], references: [id])
  tipo             TipoDocumentoOperativo
  origen           OrigenOperativo
  ticketRef        String?                @map("ticket_ref")
  /// Día del reporte (Reporte Job); nulo en el Reporte de Herramientas, que es uno por servicio.
  fecha            DateTime?              @db.Date
  /// Quién lo firmó en campo (nombre) y cuándo; supervisor y operador son cuentas de identidad (FK).
  firmadoPor       String?                @map("firmado_por")
  firmadoAt        DateTime?              @map("firmado_at") @db.Timestamptz(6)
  supervisorId     String?                @map("supervisor_id") @db.Uuid
  supervisor       IdUsuario?             @relation("docopSupervisor", fields: [supervisorId], references: [id])
  operadorId       String?                @map("operador_id") @db.Uuid
  operador         IdUsuario?             @relation("docopOperador", fields: [operadorId], references: [id])
  recibidoAt       DateTime               @default(now()) @map("recibido_at") @db.Timestamptz(6)
  recibidoPor      String                 @map("recibido_por") @db.Uuid
  /// Facturación corrigió este día: desde entonces el ticket ya no puede reenviarlo (contrato 4.4).
  corregidoAt      DateTime?              @map("corregido_at") @db.Timestamptz(6)
  corregidoPor     String?                @map("corregido_por") @db.Uuid

  actividades  DocumentoOperativoActividad[]
  herramientas DocumentoOperativoHerramienta[]

  @@index([pedidoId, tipo])
  @@map("documento_operativo")
  @@schema("comercial")
}

/// Actividad de la bitácora de un Reporte Job (DYN-SGI-RE-047).
model DocumentoOperativoActividad {
  id            String             @id @db.Uuid
  documentoId   String             @map("documento_id") @db.Uuid
  documento     DocumentoOperativo @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  orden         Int
  fecha         DateTime           @db.Date
  /// 'HH:mm'
  horaInicio    String             @map("hora_inicio")
  horaFin       String             @map("hora_fin")
  duracionHoras Decimal            @map("duracion_horas") @db.Decimal(5, 2)
  detalle       String
  autor         String?

  tablas DocumentoOperativoActividadTabla[]

  @@unique([documentoId, orden])
  @@map("documento_operativo_actividad")
  @@schema("comercial")
}

/// Tabla dentro de una actividad del Reporte Job (por ejemplo, de monitoreo): encabezados, filas y celdas, sin JSON.
model DocumentoOperativoActividadTabla {
  id          String                      @id @db.Uuid
  actividadId String                      @map("actividad_id") @db.Uuid
  actividad   DocumentoOperativoActividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  orden       Int
  titulo      String?

  columnas DocumentoOperativoTablaColumna[]
  filas    DocumentoOperativoTablaFila[]

  @@unique([actividadId, orden])
  @@map("documento_operativo_actividad_tabla")
  @@schema("comercial")
}

model DocumentoOperativoTablaColumna {
  id         String                           @id @db.Uuid
  tablaId    String                           @map("tabla_id") @db.Uuid
  tabla      DocumentoOperativoActividadTabla @relation(fields: [tablaId], references: [id], onDelete: Cascade)
  orden      Int
