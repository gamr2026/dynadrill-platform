{
  "name": "fcr",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/operaciones/fcr/src",
  "projectType": "library",
  "tags": ["scope:operaciones", "type:module"],
  "// targets": "to see all targets run: nx show project fcr --web",
  "targets": {
    "prisma-generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/prisma/schema.prisma"],
      "outputs": ["{projectRoot}/src/generated"],
      "options": {
        "command": "prisma generate",
        "cwd": "libs/operaciones/fcr"
      }
    },
    "test": {
      "dependsOn": ["prisma-generate"]
    },
    "lint": {
      "dependsOn": ["prisma-generate"]
    }
  }
}
