/// Versión de la matriz IPERC de una actividad (DYN-SGI-RE-087, GTC 45). Las reglas las garantiza el trigger `iperc_matriz_validar`.
model IpercMatriz {
  id                     String         @id @db.Uuid
  numero                 Int            @unique @default(autoincrement())
  actividadId            String         @map("actividad_id") @db.Uuid
  actividad              IpercActividad @relation(fields: [actividadId], references: [id])
  version                Int
  estado                 EstadoIperc    @default(borrador)
  origenTicketId         String?        @map("origen_ticket_id") @db.Uuid
  origenTicket           TicketRef?     @relation(fields: [origenTicketId], references: [ticketId])
  procedimientoArchivoId String?        @map("procedimiento_archivo_id") @db.Uuid
  procedimiento          ArchivoRef?    @relation("ipercProcedimiento", fields: [procedimientoArchivoId], references: [id])
  atsArchivoId           String?        @map("ats_archivo_id") @db.Uuid
  ats                    ArchivoRef?    @relation("ipercAts", fields: [atsArchivoId], references: [id])
  aprobadaPor            String?        @map("aprobada_por") @db.Uuid
  aprobador              IdUsuario?     @relation("ipercAprobador", fields: [aprobadaPor], references: [id])
  aprobadaAt             DateTime?      @map("aprobada_at") @db.Timestamptz(6)
  aprobadaEl             DateTime?      @map("aprobada_el") @db.Date
  vigenteHasta           DateTime?      @map("vigente_hasta") @db.Date
  rechazadaPor           String?        @map("rechazada_por") @db.Uuid
  rechazador             IdUsuario?     @relation("ipercRechazador", fields: [rechazadaPor], references: [id])
  rechazadaAt            DateTime?      @map("rechazada_at") @db.Timestamptz(6)
  motivoRechazo          String?        @map("motivo_rechazo")
  reemplazadaAt          DateTime?      @map("reemplazada_at") @db.Timestamptz(6)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy              String         @map("created_by") @db.Uuid
  creador                IdUsuario      @relation("ipercMatrizCreador", fields: [createdBy], references: [id])
  updatedAt              DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy              String?        @map("updated_by") @db.Uuid
  editor                 IdUsuario?     @relation("ipercMatrizEditor", fields: [updatedBy], references: [id])

  evaluadores IpercMatrizEvaluador[]
  tareas      IpercTarea[]
  historial   IpercHistorial[]
  ptws        PtwMatriz[]

  @@unique([actividadId, version])
  @@index([estado])
  @@map("iperc_matriz")
  @@schema("qhse")
}

