  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String              @map("created_by") @db.Uuid
  creador           IdUsuario           @relation("inspeccionCreador", fields: [createdBy], references: [id])

  resultados InspeccionResultado[]

  @@index([tipoId, equipoCodigo, fecha(sort: Desc)])
  @@index([resultado])
  @@map("inspeccion")
  @@schema("qhse")
}

model InspeccionResultado {
  inspeccionId String             @map("inspeccion_id") @db.Uuid
  inspeccion   Inspeccion         @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  criterioId   String             @map("criterio_id") @db.Uuid
  criterio     InspeccionCriterio @relation(fields: [criterioId], references: [id])
  cumple       Boolean

  @@id([inspeccionId, criterioId])
  @@map("inspeccion_resultado")
  @@schema("qhse")
}

// ---------------------------------------------------------------------------------------------------------------
// Espejos de SOLO LECTURA de tablas de `identidad`, para obtener el nombre con JOIN a partir de las FK. Este módulo nunca
// escribe en ellas (`app_qhse` solo tiene SELECT sobre estas columnas). Las administra el módulo de identidad.
// ---------------------------------------------------------------------------------------------------------------

/// `identidad.rol`.
model IdRol {
  id         String         @id @db.Uuid
  codigo     String
  nombre     String
  usuarios   IdUsuario[]
  cadenasSwa SwaRolCadena[]

  @@map("rol")
  @@schema("identidad")
}

/// `identidad.usuario`: solo lo que otros módulos pueden ver (nunca la clave ni los datos de acceso).
model IdUsuario {
  id     String  @id @db.Uuid
  nombre String
  email  String
  activo Boolean
  rolId  String  @map("rol_id") @db.Uuid
  rol    IdRol   @relation(fields: [rolId], references: [id])

  perfil IdUsuarioPerfil?

  entregasComoTrabajador   EpiEntrega[]           @relation("epiTrabajador")
  firmasComoTrabajador     EpiEntrega[]           @relation("epiFirmaTrabajador")
  firmasTh                 EpiEntrega[]           @relation("epiFirmaTh")
  aprobaciones             EpiEntrega[]           @relation("epiAprobador")
  rechazos                 EpiEntrega[]           @relation("epiRechazador")
  despachos                EpiEntrega[]           @relation("epiDespachador")
  entregasCreadas          EpiEntrega[]           @relation("epiCreador")
  entregasEditadas         EpiEntrega[]           @relation("epiEditor")
  historialEpi             EpiEntregaHistorial[]  @relation("epiHistorialActor")
  documentosCreados        DocumentoPedido[]      @relation("documentoCreador")
  documentosEditados       DocumentoPedido[]      @relation("documentoEditor")
  documentosAnulados       DocumentoPedido[]      @relation("documentoAnulador")
  ticketsSupervisados      TicketRef[]            @relation("ticketSupervisor")
  ticketsComoOperador      TicketOperador[]       @relation("ticketOperador")
  ptwCreados               Ptw[]                  @relation("ptwCreador")
  ptwEditados              Ptw[]                  @relation("ptwEditor")
  ptwAnulados              Ptw[]                  @relation("ptwAnulador")
  ptwFirmas                PtwFirma[]             @relation("ptwFirmante")
  ptwHistorial             PtwHistorial[]         @relation("ptwHistorialActor")
  swaActivadas             Swa[]                  @relation("swaActivador")
  swaEvaluadas             Swa[]                  @relation("swaEvaluador")
  swaReanudadas            Swa[]                  @relation("swaReanudador")
  swaCreadas               Swa[]                  @relation("swaCreador")
  swaEditadas              Swa[]                  @relation("swaEditor")
  swaNotificaciones        SwaNotificacion[]      @relation("swaNotificador")
  swaConfirmaciones        SwaReinicio[]          @relation("swaConfirmador")
  swaHistorial             SwaHistorial[]         @relation("swaHistorialActor")
  ipercActividadesCreadas  IpercActividad[]       @relation("ipercActividadCreador")
  ipercActividadesEditadas IpercActividad[]       @relation("ipercActividadEditor")
  ipercMatricesCreadas     IpercMatriz[]          @relation("ipercMatrizCreador")
  ipercMatricesEditadas    IpercMatriz[]          @relation("ipercMatrizEditor")
  ipercMatricesAprobadas   IpercMatriz[]          @relation("ipercAprobador")
  ipercMatricesRechazadas  IpercMatriz[]          @relation("ipercRechazador")
  ipercEvaluaciones        IpercMatrizEvaluador[] @relation("ipercEvaluador")
  ipercCoberturas          IpercCobertura[]       @relation("ipercCoberturaCreador")
  ipercHistorial           IpercHistorial[]       @relation("ipercHistorialActor")

  stopsObservador     StopTarjeta[]   @relation("stopObservador")
  stopsObservado      StopTarjeta[]   @relation("stopObservado")
  stopsAtendidas      StopTarjeta[]   @relation("stopAtendedor")
  stopsCerradas       StopTarjeta[]   @relation("stopCerrador")
  stopsCreadas        StopTarjeta[]   @relation("stopCreador")
  stopsEditadas       StopTarjeta[]   @relation("stopEditor")
  stopHistorial       StopHistorial[] @relation("stopHistorialActor")
  inspeccionesHechas  Inspeccion[]    @relation("inspeccionInspector")
  inspeccionesCreadas Inspeccion[]    @relation("inspeccionCreador")

  // investigación de incidentes (S2)
  investigacionesLideradas Investigacion[]          @relation("investigacionLider")
  investigacionesCreadas   Investigacion[]          @relation("investigacionCreador")
  investigacionesEditadas  Investigacion[]          @relation("investigacionEditor")
  investigacionHistorial   InvestigacionHistorial[] @relation("investigacionHistorialActor")

  @@map("usuario")
  @@schema("identidad")
}

/// `identidad.usuario_perfil` (datos del empleado, de AS2): la cédula y el cargo del trabajador se obtienen de aquí.
model IdUsuarioPerfil {
  usuarioId String    @id @map("usuario_id") @db.Uuid
  usuario   IdUsuario @relation(fields: [usuarioId], references: [id])
  cedula    String?
  cargo     String?

  @@map("usuario_perfil")
  @@schema("identidad")
}

/// `catalogos.bodega`: el lugar de la entrega (solo id, nombre y si está habilitada).
model CatBodega {
  id         String       @id @db.Uuid
  nombre     String
  habilitado Boolean
  entregas   EpiEntrega[]

  @@map("bodega")
  @@schema("catalogos")
}

/// `archivos.archivo`: se comprueba que el archivo existe, que no fue eliminado y que lo subió el módulo correcto.
model ArchivoRef {
  id          String            @id @db.Uuid
  moduloId    String            @map("modulo_id") @db.Uuid
  modulo      ArchivoModuloRef  @relation(fields: [moduloId], references: [id])
  eliminadoAt DateTime?         @map("eliminado_at") @db.Timestamptz(6)
  documentos  DocumentoPedido[]

  ipercProcedimientos IpercMatriz[] @relation("ipercProcedimiento")
  ipercAts            IpercMatriz[] @relation("ipercAts")

  stopFotos StopTarjeta[] @relation("stopFoto")

  @@map("archivo")
  @@schema("archivos")
}

/// `archivos.modulo_archivo`: solo el código estable del módulo que guarda el archivo.
model ArchivoModuloRef {
  id       String       @id @db.Uuid
  codigo   String
  archivos ArchivoRef[]

  @@map("modulo_archivo")
  @@schema("archivos")
}

/// `catalogos.campo`: solo id y nombre (el campo donde se observó una tarjeta STOP).
model CatCampo {
  id     String        @id @db.Uuid
  nombre String
  stops  StopTarjeta[]

  @@map("campo")
  @@schema("catalogos")
}

/// `catalogos.cliente`: solo id y nombre comercial (la operadora del lugar de una tarjeta STOP).
model CatCliente {
  id              String        @id @db.Uuid
  nombreComercial String        @map("nombre_comercial")
  stops           StopTarjeta[]

  @@map("cliente")
  @@schema("catalogos")
}

// ---------------------------------------------------------------------------------------------------------------
// Investigación de incidentes (DYN-SGI-RE-034, HSE-TRIAGE-002), sesión S2
// ---------------------------------------------------------------------------------------------------------------

enum EstadoInvestigacion {
  abierta
  en_investigacion
  en_revision
  cerrada

  @@map("estado_investigacion")
  @@schema("qhse")
}

/// Resultado del incidente con los plazos de HSE-TRIAGE-002 (catálogo).
model InvestigacionResultado {
  id                       String   @id @db.Uuid
  codigo                   String   @unique
  nombre                   String
  orden                    Int      @unique
  inicioHoras              Int      @map("inicio_horas")
  preliminarHoras          Int?     @map("preliminar_horas")
  finalDias                Int      @map("final_dias")
  plazoSupuesto            Boolean  @default(false) @map("plazo_supuesto")
  involucraLesionado       Boolean  @map("involucra_lesionado")
  sugiereNotificacionLegal Boolean  @map("sugiere_notificacion_legal")
  activo                   Boolean  @default(true)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy                String?  @map("created_by") @db.Uuid
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy                String?  @map("updated_by") @db.Uuid

  investigaciones Investigacion[]

  @@map("investigacion_resultado")
  @@schema("qhse")
}

/// Investigación de incidente o accidente. Los plazos se calculan con el catálogo de resultados.
model Investigacion {
  id                 String                 @id @db.Uuid
  numero             Int                    @unique @default(autoincrement())
  resultadoId        String                 @map("resultado_id") @db.Uuid
  resultado          InvestigacionResultado @relation(fields: [resultadoId], references: [id])
  descripcionEvento  String                 @map("descripcion_evento")
  fechaIncidente     DateTime               @map("fecha_incidente") @db.Timestamptz(6)
  ubicacion          String
  origenEmergenciaId String?                @unique @map("origen_emergencia_id") @db.Uuid
  estado             EstadoInvestigacion    @default(abierta)
  liderId            String?                @map("lider_id") @db.Uuid
  lider              IdUsuario?             @relation("investigacionLider", fields: [liderId], references: [id])
  escenaAseguradaAt  DateTime?              @map("escena_asegurada_at") @db.Timestamptz(6)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy          String                 @map("created_by") @db.Uuid
  creador            IdUsuario              @relation("investigacionCreador", fields: [createdBy], references: [id])
  updatedAt          DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy          String?                @map("updated_by") @db.Uuid
  editor             IdUsuario?             @relation("investigacionEditor", fields: [updatedBy], references: [id])

  historial InvestigacionHistorial[]

  @@index([estado])
  @@index([fechaIncidente])
  @@index([resultadoId])
  @@map("investigacion")
  @@schema("qhse")
}

/// Rastro de estados de la investigación: solo se agrega.
model InvestigacionHistorial {
  id              String               @id @db.Uuid
  investigacionId String               @map("investigacion_id") @db.Uuid
  investigacion   Investigacion        @relation(fields: [investigacionId], references: [id])
  estadoAnterior  EstadoInvestigacion? @map("estado_anterior")
  estadoNuevo     EstadoInvestigacion  @map("estado_nuevo")
  observacion     String?
  actorId         String               @map("actor_id") @db.Uuid
  actor           IdUsuario            @relation("investigacionHistorialActor", fields: [actorId], references: [id])
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([investigacionId, createdAt])
  @@map("investigacion_historial")
  @@schema("qhse")
}
