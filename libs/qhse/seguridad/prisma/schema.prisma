// Módulo `qhse` (contenedor qhse). Schema PostgreSQL: qhse. Calidad, salud, seguridad y ambiente; se construye por tramos
// (plan: documentacion/modulos/plan-qhse.md). Q1: entrega de EPI (DYN-SGI-RE-032) y la referencia de los tickets que la originan.
// Las IDs son UUIDv7 generados por la aplicación (sin DEFAULT en la base). El cliente se genera dentro del módulo y nadie
// más lo importa. Migraciones: dyn_migrator, directo a PostgreSQL (ver prisma.config.ts).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["qhse", "identidad", "catalogos", "archivos"]
}

enum EstadoEpi {
  solicitado
  aprobado
  despachado
  rechazado

  @@map("estado_epi")
  @@schema("qhse")
}

enum TipoDocumentoPedido {
  formato_recepcion
  art
  pt
  sfi
  formato_entrega

  @@map("tipo_documento_pedido")
  @@schema("qhse")
}

enum FasePtw {
  gabinete
  formalizacion
  aprobacion
  aprobado

  @@map("fase_ptw")
  @@schema("qhse")
}

enum TipoFirmaPtw {
  ptw_en_sitio
  acta_recibimiento
  barricadas
  aprobacion

  @@map("tipo_firma_ptw")
  @@schema("qhse")
}

enum AccionPtw {
  abierto
  documentos_validados
  firmado
  aprobado
  anulado

  @@map("accion_ptw")
  @@schema("qhse")
}

enum TipoTalla {
  ropa
  calzado
  guante

  @@map("tipo_talla")
  @@schema("qhse")
}

/// Ticket (de otro contenedor) que origina casos de QHSE. Se llena por evento; no hay FK al schema ajeno (decisión D1).
model TicketRef {
  ticketId     String     @id @map("ticket_id") @db.Uuid
  ticketNumero Int?       @map("ticket_numero")
  pedidoId     String     @map("pedido_id") @db.Uuid
  pedidoCodigo String     @map("pedido_codigo")
  /// Supervisor asignado al ticket (identidad.usuario).
  supervisorId String?    @map("supervisor_id") @db.Uuid
  supervisor   IdUsuario? @relation("ticketSupervisor", fields: [supervisorId], references: [id])
  /// Copias justificadas (ver COMMENT en la base): cliente, campo y pozo del pedido, mantenidas por evento.
  cliente      String?
  campo        String?
  pozo         String?
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  entregasEpi EpiEntrega[]
  documentos  DocumentoPedido[]
  ptws        Ptw[]

  @@unique([ticketId, pedidoId])
  @@index([pedidoId])
  @@map("ticket_ref")
  @@schema("qhse")
}

/// RÉPLICA de los artículos de Inventario que se entregan a una persona (otro contenedor, D1: sin FK). La mantiene el evento
/// `operaciones.inventario.articulo_epi_actualizado`; QHSE no la edita.
model EpiElemento {
  id             String     @id @db.Uuid
  /// Id del artículo en Inventario.
  articuloId     String     @unique @map("articulo_id") @db.Uuid
  /// Código del producto en AS2 (copia justificada).
  codigo         String     @unique
  nombre         String
  /// Tipo de talla que lleva el elemento; `null` = no lleva talla.
  tipoTalla      TipoTalla? @map("tipo_talla")
  activo         Boolean    @default(true)
  /// Momento (del evento) del último cambio aplicado.
  sincronizadoAt DateTime   @default(now()) @map("sincronizado_at") @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?    @map("created_by") @db.Uuid
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?    @map("updated_by") @db.Uuid

  items EpiEntregaItem[]

  @@map("epi_elemento")
  @@schema("qhse")
}

/// Tallas por tipo (ropa, calzado, guante).
model EpiTalla {
  id        String    @id @db.Uuid
  tipo      TipoTalla
  codigo    String
  orden     Int
  activo    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid

  items EpiEntregaItem[]

  @@unique([tipo, codigo])
  @@unique([tipo, orden])
  @@map("epi_talla")
  @@schema("qhse")
}

/// Entrega de EPI (DYN-SGI-RE-032): una por trabajador (y por ticket, si la origina un servicio).
model EpiEntrega {
  id                 String     @id @db.Uuid
  numero             Int        @unique @default(autoincrement())
  trabajadorId       String     @map("trabajador_id") @db.Uuid
  trabajador         IdUsuario  @relation("epiTrabajador", fields: [trabajadorId], references: [id])
  ticketId           String?    @map("ticket_id") @db.Uuid
  ticket             TicketRef? @relation(fields: [ticketId], references: [ticketId])
  /// Base o bodega donde se entrega (catalogos.bodega).
  lugarBodegaId      String?    @map("lugar_bodega_id") @db.Uuid
  lugar              CatBodega? @relation(fields: [lugarBodegaId], references: [id])
  estado             EstadoEpi  @default(solicitado)
  firmaTrabajadorPor String?    @map("firma_trabajador_por") @db.Uuid
  firmaTrabajador    IdUsuario? @relation("epiFirmaTrabajador", fields: [firmaTrabajadorPor], references: [id])
  firmaTrabajadorAt  DateTime?  @map("firma_trabajador_at") @db.Timestamptz(6)
  firmaThPor         String?    @map("firma_th_por") @db.Uuid
  firmaTh            IdUsuario? @relation("epiFirmaTh", fields: [firmaThPor], references: [id])
  firmaThAt          DateTime?  @map("firma_th_at") @db.Timestamptz(6)
  aprobadoPor        String?    @map("aprobado_por") @db.Uuid
  aprobador          IdUsuario? @relation("epiAprobador", fields: [aprobadoPor], references: [id])
  aprobadoAt         DateTime?  @map("aprobado_at") @db.Timestamptz(6)
  rechazadoPor       String?    @map("rechazado_por") @db.Uuid
  rechazador         IdUsuario? @relation("epiRechazador", fields: [rechazadoPor], references: [id])
  rechazadoAt        DateTime?  @map("rechazado_at") @db.Timestamptz(6)
  motivoRechazo      String?    @map("motivo_rechazo")
  despachadoPor      String?    @map("despachado_por") @db.Uuid
  despachador        IdUsuario? @relation("epiDespachador", fields: [despachadoPor], references: [id])
  despachadoAt       DateTime?  @map("despachado_at") @db.Timestamptz(6)
  createdBy          String?    @map("created_by") @db.Uuid
  creador            IdUsuario? @relation("epiCreador", fields: [createdBy], references: [id])
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy          String?    @map("updated_by") @db.Uuid
  editor             IdUsuario? @relation("epiEditor", fields: [updatedBy], references: [id])
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  items     EpiEntregaItem[]
  historial EpiEntregaHistorial[]

  @@index([trabajadorId])
  @@index([lugarBodegaId])
  @@index([estado])
  @@map("epi_entrega")
  @@schema("qhse")
}

model EpiEntregaItem {
  id                  String      @id @db.Uuid
  entregaId           String      @map("entrega_id") @db.Uuid
  entrega             EpiEntrega  @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  elementoId          String      @map("elemento_id") @db.Uuid
  elemento            EpiElemento @relation(fields: [elementoId], references: [id])
  cantidad            Int
  tallaId             String?     @map("talla_id") @db.Uuid
  talla               EpiTalla?   @relation(fields: [tallaId], references: [id])
  recibioCapacitacion Boolean     @default(false) @map("recibio_capacitacion")
  observaciones       String?
  entregadoEl         DateTime    @default(now()) @map("entregado_el") @db.Date
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           String?     @map("created_by") @db.Uuid
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy           String?     @map("updated_by") @db.Uuid

  @@index([entregaId])
  @@map("epi_entrega_item")
  @@schema("qhse")
}

/// Rastro de cada cambio de estado de una entrega (solo se agrega).
model EpiEntregaHistorial {
  id             String     @id @db.Uuid
  entregaId      String     @map("entrega_id") @db.Uuid
  entrega        EpiEntrega @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  estadoAnterior EstadoEpi? @map("estado_anterior")
  estadoNuevo    EstadoEpi  @map("estado_nuevo")
  motivo         String?
  actorId        String?    @map("actor_id") @db.Uuid
  actor          IdUsuario? @relation("epiHistorialActor", fields: [actorId], references: [id])
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entregaId, createdAt])
  @@map("epi_entrega_historial")
  @@schema("qhse")
}

/// Documento de seguridad de un pedido (contrato 4.11). Solo se anula; nunca se edita ni se borra (privilegios por columna).
model DocumentoPedido {
  id              String              @id @db.Uuid
  /// Pedido de comercial (otro contenedor, D1: sin FK).
  pedidoId        String              @map("pedido_id") @db.Uuid
  ticketId        String?             @map("ticket_id") @db.Uuid
  ticket          TicketRef?          @relation(fields: [ticketId, pedidoId], references: [ticketId, pedidoId])
  tipo            TipoDocumentoPedido
  archivoId       String              @map("archivo_id") @db.Uuid
  archivo         ArchivoRef          @relation(fields: [archivoId], references: [id])
  referencia      String?
  /// Solo el Acta: por qué la subió otra persona y no el supervisor asignado.
  motivoSuplencia String?             @map("motivo_suplencia")
  fecha           DateTime?           @db.Date
  vigenteHasta    DateTime?           @map("vigente_hasta") @db.Date
  anuladoAt       DateTime?           @map("anulado_at") @db.Timestamptz(6)
  anuladoPor      String?             @map("anulado_por") @db.Uuid
  anulador        IdUsuario?          @relation("documentoAnulador", fields: [anuladoPor], references: [id])
  motivoAnulacion String?             @map("motivo_anulacion")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String              @map("created_by") @db.Uuid
  creador         IdUsuario           @relation("documentoCreador", fields: [createdBy], references: [id])
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?             @map("updated_by") @db.Uuid
  editor          IdUsuario?          @relation("documentoEditor", fields: [updatedBy], references: [id])

  ptwRecepcion Ptw[] @relation("ptwRecepcion")
  ptwArt       Ptw[] @relation("ptwArt")
  ptwPt        Ptw[] @relation("ptwPt")
  ptwSfi       Ptw[] @relation("ptwSfi")

  @@index([pedidoId, tipo])
  @@index([ticketId])
  @@index([archivoId])
  @@map("documento_pedido")
  @@schema("qhse")
}

/// Permiso de Trabajo (HSE-SITIO-001): uno vigente por pedido y día de operación. Las fases las garantiza el trigger `ptw_validar`.
model Ptw {
  id                   String           @id @db.Uuid
  numero               Int              @unique @default(autoincrement())
  ticketId             String           @map("ticket_id") @db.Uuid
  /// Pedido de comercial (otro contenedor, D1: sin FK); se valida por la FK compuesta con el ticket.
  pedidoId             String           @map("pedido_id") @db.Uuid
  ticket               TicketRef        @relation(fields: [ticketId, pedidoId], references: [ticketId, pedidoId])
  diaOperacion         DateTime         @map("dia_operacion") @db.Date
  fase                 FasePtw          @default(gabinete)
  documentoRecepcionId String?          @map("documento_recepcion_id") @db.Uuid
  documentoRecepcion   DocumentoPedido? @relation("ptwRecepcion", fields: [documentoRecepcionId], references: [id])
  documentoArtId       String?          @map("documento_art_id") @db.Uuid
  documentoArt         DocumentoPedido? @relation("ptwArt", fields: [documentoArtId], references: [id])
  documentoPtId        String?          @map("documento_pt_id") @db.Uuid
  documentoPt          DocumentoPedido? @relation("ptwPt", fields: [documentoPtId], references: [id])
  documentoSfiId       String?          @map("documento_sfi_id") @db.Uuid
  documentoSfi         DocumentoPedido? @relation("ptwSfi", fields: [documentoSfiId], references: [id])
  anuladoAt            DateTime?        @map("anulado_at") @db.Timestamptz(6)
  anuladoPor           String?          @map("anulado_por") @db.Uuid
  anulador             IdUsuario?       @relation("ptwAnulador", fields: [anuladoPor], references: [id])
  motivoAnulacion      String?          @map("motivo_anulacion")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy            String           @map("created_by") @db.Uuid
  creador              IdUsuario        @relation("ptwCreador", fields: [createdBy], references: [id])
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy            String?          @map("updated_by") @db.Uuid
  editor               IdUsuario?       @relation("ptwEditor", fields: [updatedBy], references: [id])

  firmas    PtwFirma[]
  historial PtwHistorial[]

  @@index([ticketId])
  @@index([pedidoId, diaOperacion])
  @@index([fase])
  @@map("ptw")
  @@schema("qhse")
}

/// Confirmación «de una línea» (usuario + hora del servidor) del PTW; migrará a la plataforma de Firmas (D6). Inmutable.
model PtwFirma {
  id        String       @id @db.Uuid
  ptwId     String       @map("ptw_id") @db.Uuid
  ptw       Ptw          @relation(fields: [ptwId], references: [id], onDelete: Cascade)
  tipo      TipoFirmaPtw
  usuarioId String       @map("usuario_id") @db.Uuid
  usuario   IdUsuario    @relation("ptwFirmante", fields: [usuarioId], references: [id])
  firmadoAt DateTime     @default(now()) @map("firmado_at") @db.Timestamptz(6)

  @@unique([ptwId, tipo])
  @@map("ptw_firma")
  @@schema("qhse")
}

/// Rastro de cada acción sobre un PTW (solo se agrega).
model PtwHistorial {
  id        String    @id @db.Uuid
  ptwId     String    @map("ptw_id") @db.Uuid
  ptw       Ptw       @relation(fields: [ptwId], references: [id], onDelete: Cascade)
  accion    AccionPtw
  motivo    String?
  actorId   String    @map("actor_id") @db.Uuid
  actor     IdUsuario @relation("ptwHistorialActor", fields: [actorId], references: [id])
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ptwId, createdAt])
  @@map("ptw_historial")
  @@schema("qhse")
}

// ---------------------------------------------------------------------------------------------------------------
// Espejos de SOLO LECTURA de tablas de `identidad`, para obtener el nombre con JOIN a partir de las FK. Este módulo nunca
// escribe en ellas (`app_qhse` solo tiene SELECT sobre estas columnas). Las administra el módulo de identidad.
// ---------------------------------------------------------------------------------------------------------------

/// `identidad.rol`.
model IdRol {
  id       String      @id @db.Uuid
  codigo   String
  nombre   String
  usuarios IdUsuario[]

  @@map("rol")
  @@schema("identidad")
}

/// `identidad.usuario`: solo lo que otros módulos pueden ver (nunca la clave ni los datos de acceso).
model IdUsuario {
  id     String  @id @db.Uuid
  nombre String
  email  String
  activo Boolean
  rolId  String  @map("rol_id") @db.Uuid
  rol    IdRol   @relation(fields: [rolId], references: [id])

  perfil IdUsuarioPerfil?

  entregasComoTrabajador EpiEntrega[]          @relation("epiTrabajador")
  firmasComoTrabajador   EpiEntrega[]          @relation("epiFirmaTrabajador")
  firmasTh               EpiEntrega[]          @relation("epiFirmaTh")
  aprobaciones           EpiEntrega[]          @relation("epiAprobador")
  rechazos               EpiEntrega[]          @relation("epiRechazador")
  despachos              EpiEntrega[]          @relation("epiDespachador")
  entregasCreadas        EpiEntrega[]          @relation("epiCreador")
  entregasEditadas       EpiEntrega[]          @relation("epiEditor")
  historialEpi           EpiEntregaHistorial[] @relation("epiHistorialActor")
  documentosCreados      DocumentoPedido[]     @relation("documentoCreador")
  documentosEditados     DocumentoPedido[]     @relation("documentoEditor")
  documentosAnulados     DocumentoPedido[]     @relation("documentoAnulador")
  ticketsSupervisados    TicketRef[]           @relation("ticketSupervisor")
  ptwCreados             Ptw[]                 @relation("ptwCreador")
  ptwEditados            Ptw[]                 @relation("ptwEditor")
  ptwAnulados            Ptw[]                 @relation("ptwAnulador")
  ptwFirmas              PtwFirma[]            @relation("ptwFirmante")
  ptwHistorial           PtwHistorial[]        @relation("ptwHistorialActor")

  @@map("usuario")
  @@schema("identidad")
}

/// `identidad.usuario_perfil` (datos del empleado, de AS2): la cédula y el cargo del trabajador se obtienen de aquí.
model IdUsuarioPerfil {
  usuarioId String    @id @map("usuario_id") @db.Uuid
  usuario   IdUsuario @relation(fields: [usuarioId], references: [id])
  cedula    String?
  cargo     String?

  @@map("usuario_perfil")
  @@schema("identidad")
}

/// `catalogos.bodega`: el lugar de la entrega (solo id, nombre y si está habilitada).
model CatBodega {
  id         String       @id @db.Uuid
  nombre     String
  habilitado Boolean
  entregas   EpiEntrega[]

  @@map("bodega")
  @@schema("catalogos")
}

/// `archivos.archivo`: se comprueba que el archivo existe, que no fue eliminado y que lo subió el módulo correcto.
model ArchivoRef {
  id          String            @id @db.Uuid
  moduloId    String            @map("modulo_id") @db.Uuid
  modulo      ArchivoModuloRef  @relation(fields: [moduloId], references: [id])
  eliminadoAt DateTime?         @map("eliminado_at") @db.Timestamptz(6)
  documentos  DocumentoPedido[]

  @@map("archivo")
  @@schema("archivos")
}

/// `archivos.modulo_archivo`: solo el código estable del módulo que guarda el archivo.
model ArchivoModuloRef {
  id       String       @id @db.Uuid
  codigo   String
  archivos ArchivoRef[]

  @@map("modulo_archivo")
  @@schema("archivos")
}
