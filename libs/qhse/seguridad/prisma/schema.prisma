  accionesQueObserva    String?     @map("acciones_que_observa")
  accionesAccion        String?     @map("acciones_accion")
  condicionesQueObserva String?     @map("condiciones_que_observa")
  condicionesAccion     String?     @map("condiciones_accion")
  estado                EstadoStop  @default(abierto)
  atendidoPor           String?     @map("atendido_por") @db.Uuid
  atendedor             IdUsuario?  @relation("stopAtendedor", fields: [atendidoPor], references: [id])
  atendidoAt            DateTime?   @map("atendido_at") @db.Timestamptz(6)
  atendidoObservacion   String?     @map("atendido_observacion")
  cerradoPor            String?     @map("cerrado_por") @db.Uuid
  cerrador              IdUsuario?  @relation("stopCerrador", fields: [cerradoPor], references: [id])
  cerradoAt             DateTime?   @map("cerrado_at") @db.Timestamptz(6)
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy             String      @map("created_by") @db.Uuid
  creador               IdUsuario   @relation("stopCreador", fields: [createdBy], references: [id])
  updatedAt             DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy             String?     @map("updated_by") @db.Uuid
  editor                IdUsuario?  @relation("stopEditor", fields: [updatedBy], references: [id])

